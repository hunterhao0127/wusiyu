{
  "name": "wusiyu",
  "version": "1.6.0",
  "description": "务思语 - 英语沉浸阅读器",
  "main": "main.js",
  "author": "wusiyu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build-backend": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-windows-backend.ps1",
    "dist": "electron-builder --win --x64",
    "build-windows": "npm run build-backend && npm run dist"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.wusiyu.reader",
    "productName": "务思语",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/wusiyu_backend.exe",
        "to": "backend/wusiyu_backend.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "wusiyu_logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "务思语",
      "installerIcon": "wusiyu_logo.ico",
      "uninstallerIcon": "wusiyu_logo.ico",
      "license": false
    }
  }
}
